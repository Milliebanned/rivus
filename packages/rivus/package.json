{
  "name": "rivus-meter",
  "version": "0.1.0",
  "description": "Pay-per-second billing for compute and APIs on Tempo: meter an endpoint in a few lines, pay for one from an agent, refund whatever isn't used.",
  "keywords": [
    "tempo",
    "payments",
    "metering",
    "usage-billing",
    "streaming-payments",
    "agents",
    "http-402"
  ],
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20.12"
  },
  "bin": {
    "rivus": "./dist/cli.js",
    "rivus-meter": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "mppx": "^0.11.0",
    "viem": "^2.57.0"
  }
}
