{
  "name": "rivus",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "npm run build:sdk",
    "dev": "next dev",
    "prebuild": "npm run build:sdk",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "build:sdk": "npm --prefix packages/rivus run build",
    "setup": "tsx packages/rivus/src/cli.ts init",
    "smoke": "tsx packages/rivus/src/cli.ts pay http://localhost:3000/api/render",
    "bench": "tsx scripts/bench-fractal.mts"
  },
  "dependencies": {
    "mppx": "^0.11.0",
    "next": "16.3.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "viem": "^2.57.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.7",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=20.12"
  }
}
